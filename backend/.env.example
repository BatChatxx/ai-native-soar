# SOAR Backend Environment Variables

# Database
DATABASE_URL=postgresql://soar_user:soar_password@postgres:5432/soar

# API Security
SOAR_API_SECRET=your-super-secret-key-change-this-in-production

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000

# LLM Configuration
LLM_ENDPOINT=http://llm-server:11434/v1
LLM_MODEL=qwen3.5:9b

# Airflow Configuration
AIRFLOW__CORE__DAGS_TO_RUN=SOAR_Pipeline

# Redis
REDIS_PASSWORD=

# PostgreSQL
POSTGRES_PASSWORD=soar_password
