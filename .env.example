# ==========================================
# SOAR Platform Environment Variables
# ==========================================

# ==========================================
# Database
# ==========================================
POSTGRES_PASSWORD=soar_password
POSTGRES_PORT=5432

# ==========================================
# API Server
# ==========================================
SOAR_API_PORT=8000
SOAR_API_SECRET=your-secret-key-change-in-production

# ==========================================
# CORS
# ==========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://redis:6379/0

# ==========================================
# AI/LLM (Optional - requires Ollama)
# ==========================================
# Set to empty string to disable AI features
LLM_ENDPOINT=
LLM_MODEL=qwen3.5:9b
LLM_API_KEY=

# ==========================================
# Airflow (Optional)
# ==========================================
# Set to empty string to disable Airflow
AIRFLOW_ENABLED=false
AIRFLOW__CORE__DAGS_TO_RUN=SOAR_Pipeline
AIRFLOW__DATABASE__DATABASE_CONNECTION=sqlite:////airflow-db/airflow.db
AIRFLOW__CORE__FERNET_KEY=example_fernet_key
AIRFLOW_PORT=8080

# ==========================================
# Frontend (Optional)
# ==========================================
SOAR_FRONTEND_PORT=80

# ==========================================
# Security
# ==========================================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
LOG_LEVEL=INFO
